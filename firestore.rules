rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
      match /contributions/{contributionId} {
        allow read, create, update, delete: if true;
      }
      match /farewell_students/{studentId} {
        allow read, create, update, delete: if true;
      }
      match /settings/{settingId} {
        allow read, create, update, delete: if true;
      }
  }
}
